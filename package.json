{
  "name": "@digitalwalletcorp/vue-core",
  "version": "0.2.0",
  "type": "module",
  "description": "Basic UI components for Vue 3",
  "main": "lib/index.cjs",
  "module": "lib/index.js",
  "types": "lib/index.d.ts",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js",
      "require": "./lib/index.cjs"
    },
    "./nuxt": {
      "types": "./lib/nuxt.d.ts",
      "import": "./lib/nuxt.js"
    },
    "./register": {
      "types": "./lib/register.d.ts",
      "import": "./lib/register.js",
      "require": "./lib/register.cjs"
    },
    "./global": {
      "types": "./lib/global.d.ts"
    },
    "./style.css": "./lib/style.css",
    "./*": {
      "types": "./lib/*.d.ts",
      "import": "./lib/*.js",
      "require": "./lib/*.cjs"
    }
  },
  "scripts": {
    "build": "vite build",
    "install:dev": "rm -rf lib dest && find node_modules -mindepth 1 -delete && yarn install",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "version:patch": "npm version patch",
    "version:minor": "npm version minor",
    "version:major": "npm version major",
    "prepack": "rm -rf lib && npm run build",
    "pack": "rm -rf dest && mkdir -p dest && npm pack --pack-destination=dest",
    "publish:npm": "bash ../bin/publish.sh",
    "test:unit": "vitest run --coverage"
  },
  "keywords": [
    "vue",
    "vue3",
    "nuxt",
    "components",
    "ui"
  ],
  "author": "satoshi kotaki",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/digitalwalletcorp/vue-core.git"
  },
  "homepage": "https://github.com/digitalwalletcorp/vue-core",
  "bugs": {
    "url": "https://github.com/digitalwalletcorp/vue-core/issues"
  },
  "files": [
    "lib/**/*",
    "src/**/*"
  ],
  "peerDependencies": {
    "vue": "^3.5.29"
  },
  "devDependencies": {
    "@nuxt/kit": "^3.17.5",
    "@types/node": "24.13.6",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vitest/coverage-v8": "3.2.4",
    "@vue/test-utils": "2.4.6",
    "happy-dom": "20.14.5",
    "nuxt": "^3.17.5",
    "typescript": "6.0.3",
    "vite": "^7.0.0",
    "vite-plugin-dts": "5.1.0",
    "vite-tsconfig-paths": "6.1.1",
    "vitest": "3.2.4",
    "vue": "^3.5.29",
    "vue-tsc": "3.1.5"
  },
  "dependencies": {
    "@digitalwalletcorp/vue-svg-icons": "^1.13.0"
  }
}
